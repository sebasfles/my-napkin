# Copy to .env.local and fill it.
# The password and the secret are yours to choose; the table and the bucket come
# from `terraform output` in infra/environments/dev.
# The AWS region comes from the ambient environment, never from a variable here.

# The password that opens the app.
APP_PASSWORD=

# Random string used to sign the session cookie; `openssl rand -base64 32` is enough.
SESSION_SECRET=

# DynamoDB table with the diagram index.
DIAGRAMS_TABLE=napkin-dev-diagrams

# S3 bucket holding scenes/{id}.json.
SCENES_BUCKET=napkin-dev-scenes-000000000000

# Profile the AWS SDK picks up locally; in AWS the Lambda role is used instead.
AWS_PROFILE=personal
